# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Path to the SQLite database file
DB_PATH=/opt/avito_bot/avito_bot.db

# Telegram numeric user id of the person who should be bootstrapped
# as the first "Админ" (director) role on first start.
SUPERADMIN_TELEGRAM_ID=123456789

LOG_LEVEL=INFO

# Used by the single-instance file lock (fcntl.flock) so systemd and an
# accidental manual `python main.py` from ssh can never both run pollers
# against the same DB at once. Defaults next to DB_PATH if unset.
PID_FILE=/opt/avito_bot/avito_bot.pid

# Optional one-time bootstrap file for Avito/AI/proxy credentials.
# See credentials.example.toml. Safe to leave unset/missing.
CREDENTIALS_PATH=/opt/avito_bot/credentials.toml

# Telegram Mini App backend (webapp.py) — an aiohttp.web server sharing the
# bot's own DB/cache, bound to WEBAPP_HOST:WEBAPP_PORT (localhost-only;
# put nginx+certbot in front for real HTTPS, Telegram won't load a Mini
# App otherwise). The whole feature stays off until WEBAPP_URL is set —
# leave it unset/empty to run the bot exactly as before, no Mini App button.
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8080
# Public https:// address of the Mini App, once a domain+TLS are set up
# (see nginx/certbot deploy notes). Example: https://app.example.com
WEBAPP_URL=
